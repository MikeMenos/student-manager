generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionType {
  Speech
  Occupational
  Psychological
  Behavioral
}

enum TherapyCenters {
  Patras
  Amaliada
  Aigio
}

model Student {
  id          String         @id @default(uuid())
  firstName   String
  lastName    String
  age         String
  grade       String
  homeAddress String
  school      String
  center      TherapyCenters
  parentInfo  ParentInfo[]
  attendances Attendance[]
  therapists  Therapist[]    @relation("StudentTherapists")
}

model Therapist {
  id            String         @id @default(uuid())
  therapistId   String         @unique
  therapistRole SessionType
  therapistName String
  email         String
  phone         String
  center        TherapyCenters

  attendances Attendance[] @relation("TherapistByClerkId")

  students Student[] @relation("StudentTherapists")
}

model Attendance {
  id              String      @id @default(uuid())
  sessionDate     String
  sessionType     SessionType
  sessionDuration Int

  studentId   String
  therapistId String

  student Student @relation(fields: [studentId], references: [id])

  therapist Therapist @relation("TherapistByClerkId", fields: [therapistId], references: [therapistId])

  @@index([studentId, sessionDate])
  @@index([therapistId])
}

model ParentInfo {
  id         String  @id @default(cuid())
  parentName String
  relation   String
  phone      String
  email      String?

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}
