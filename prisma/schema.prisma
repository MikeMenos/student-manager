generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionType {
  Speech
  Occupational
  Psychological
  Behavioral
}

model Student {
  id          String       @id @default(uuid())
  firstName   String
  lastName    String
  age         String
  grade       String
  homeAddress String
  school      String
  center      String
  parentInfo  ParentInfo[]
  attendances Attendance[]
  therapists  Therapist[]  @relation("StudentTherapists")
}

model Therapist {
  id            String       @id @default(uuid())
  therapistRole SessionType
  therapistName String
  email         String
  students      Student[]    @relation("StudentTherapists")
  attendances   Attendance[]
}

model Attendance {
  id              String      @id @default(uuid())
  sessionDate     String
  sessionType     SessionType
  sessionDuration Int

  studentId   String
  therapistId String

  student   Student   @relation(fields: [studentId], references: [id])
  therapist Therapist @relation(fields: [therapistId], references: [id])

  @@index([studentId, sessionDate])
  @@index([therapistId])
}

model ParentInfo {
  id         String  @id @default(cuid())
  parentName String
  relation   String
  phone      String
  email      String?

  studentId String
  Student   Student @relation(fields: [studentId], references: [id])
}
